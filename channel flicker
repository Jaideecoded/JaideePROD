/* ==========================================================================
   ChannelFlicker — YouTube IFrame Player wrapper
   --------------------------------------------------------------------------
   Thin wrapper around the YouTube IFrame Player API. Keeps the rest of the
   app free of YT specifics. The player is created muted so autoplay works
   under browser policy; the app unmutes on first user interaction.
   ========================================================================== */

window.TVPlayer = (function () {
  'use strict';

  let player = null;
  let ready = false;
  let apiFailed = false;
  const listeners = { ready: [], ended: [], error: [], playing: [] };

  function emit(event, arg) {
    listeners[event].forEach(function (fn) { fn(arg); });
  }

  /** Load the IFrame API script once, with a timeout for offline use. */
  function loadAPI() {
    return new Promise(function (resolve, reject) {
      if (window.YT && window.YT.Player) return resolve();

      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function () {
        if (typeof previous === 'function') previous();
        resolve();
      };

      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      tag.onerror = function () { apiFailed = true; reject(new Error('YT API unreachable')); };
      document.head.appendChild(tag);

      // Offline / blocked network: give up after 8s and tell the app.
      setTimeout(function () {
        if (!(window.YT && window.YT.Player)) {
          apiFailed = true;
          reject(new Error('YT API timeout'));
        }
      }, 8000);
    });
  }

  function create(mountId) {
    return loadAPI().then(function () {
      return new Promise(function (resolve) {
        player = new YT.Player(mountId, {
          width: '100%',
          height: '100%',
          playerVars: {
            autoplay: 1,
            mute: 1,            // required for reliable autoplay
            controls: 0,
            rel: 0,
            iv_load_policy: 3,
            disablekb: 1,
            playsinline: 1,
            fs: 0
          },
          events: {
            onReady: function () {
              ready = true;
              resolve();
              emit('ready');
            },
            onStateChange: function (e) {
              if (e.data === YT.PlayerState.ENDED) emit('ended');
              if (e.data === YT.PlayerState.PLAYING) emit('playing');
            },
            onError: function (e) { emit('error', e.data); }
          }
        });
      });
    });
  }

  /* ---- public API ------------------------------------------------------- */

  function load(videoId) {
    if (!ready) return;
    // loadVideoById auto-plays; the player stays muted until the app unmutes.
    player.loadVideoById(videoId);
  }

  function setVolume(percent) {
    if (ready) player.setVolume(Math.max(0, Math.min(100, percent)));
  }

  function mute()   { if (ready) player.mute(); }
  function unMute() { if (ready) player.unMute(); }
  function isMuted() { return ready ? player.isMuted() : true; }
  function isReady() { return ready; }
  /** Stop playback + audio when another source takes the screen. */
  function pause() { if (ready) { try { player.pauseVideo(); } catch (e) { /* not ready */ } } }

  return {
    create: create,
    load: load,
    setVolume: setVolume,
    mute: mute,
    unMute: unMute,
    isMuted: isMuted,
    isReady: isReady,
    pause: pause,
    on: function (event, fn) {
      if (listeners[event]) listeners[event].push(fn);
    }
  };
})();

