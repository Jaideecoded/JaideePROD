/* ==========================================================================
   ChannelFlicker — analog static
   --------------------------------------------------------------------------
   Renders chunky low-res TV noise on a canvas (stretched by CSS for the
   analog feel) and, when audio is unlocked, plays a short white-noise
   burst through the Web Audio API. Zero dependencies.
   ========================================================================== */

window.TVStatic = (function () {
  'use strict';

  const canvas = document.getElementById('staticCanvas');
  const ctx = canvas.getContext('2d', { alpha: false });
  const WIDTH = canvas.width;   // 320 — deliberately low res
  const HEIGHT = canvas.height; // 240

  let imageData = ctx.createImageData(WIDTH, HEIGHT);
  let rafId = null;
  let running = false;
  let audioCtx = null;

  /* ---- noise rendering ------------------------------------------------- */

  function drawNoiseFrame() {
    const px = imageData.data;
    // Random grayscale + faint colour fringing reads as "analog" at low res.
    for (let i = 0; i < px.length; i += 4) {
      const v = (Math.random() * 255) | 0;
      px[i]     = Math.min(255, v + 30);        // R
      px[i + 1] = v;                            // G
      px[i + 2] = Math.min(255, v + 10);        // B
      px[i + 3] = 255;                          // A
    }
    ctx.putImageData(imageData, 0, 0);

    // Occasional horizontal tear line for extra analog ugliness.
    if (Math.random() < 0.18) {
      const y = (Math.random() * HEIGHT) | 0;
      const h = 2 + ((Math.random() * 6) | 0);
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.fillRect(0, y, WIDTH, h);
    }
  }

  function loop() {
    drawNoiseFrame();
    rafId = requestAnimationFrame(loop);
  }

  /* ---- white noise burst (Web Audio) ----------------------------------- */

  function ensureAudioContext() {
    if (audioCtx) return audioCtx;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    try {
      audioCtx = new AC();
    } catch (e) {
      audioCtx = null;
    }
    return audioCtx;
  }

  /** May fail silently before a user gesture — that is expected and fine. */
  function playWhiteNoise(ms) {
    const ac = ensureAudioContext();
    if (!ac) return;
    if (ac.state === 'suspended') {
      ac.resume().catch(function () {});
    }

    const sampleCount = Math.floor((ac.sampleRate * ms) / 1000);
    if (sampleCount <= 0) return;

    const buffer = ac.createBuffer(1, sampleCount, ac.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < sampleCount; i++) {
      data[i] = (Math.random() * 2 - 1) * 0.35;
    }

    const source = ac.createBufferSource();
    source.buffer = buffer;

    // Quick fade in/out so the burst doesn't click.
    const gain = ac.createGain();
    const t0 = ac.currentTime;
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.exponentialRampToValueAtTime(0.8, t0 + 0.02);
    gain.gain.setValueAtTime(0.8, t0 + ms / 1000 - 0.05);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + ms / 1000);

    source.connect(gain).connect(ac.destination);
    source.start(t0);
  }

  /* ---- public API ------------------------------------------------------- */

  /**
   * Play static for `ms` milliseconds, then call `onDone`.
   * Also fires a white-noise burst if audio has been unlocked.
   */
  function burst(ms, options) {
    options = options || {};
    const onDone = options.onDone || null;
    const withSound = options.sound !== false;

    // Keep only the latest onDone so overlapping bursts can't lose it.
    burst._onDone = onDone;

    if (running) {
      // Already static-ing: just extend the current burst.
      clearTimeout(burst._timer);
      burst._timer = setTimeout(finish, ms);
      if (withSound) playWhiteNoise(ms);
      return;
    }

    running = true;
    canvas.classList.add('visible');
    drawNoiseFrame();
    rafId = requestAnimationFrame(loop);
    if (withSound) playWhiteNoise(ms);
    burst._timer = setTimeout(finish, ms);

    function finish() {
      if (!running) return; // guard against double-fire
      running = false;
      cancelAnimationFrame(rafId);
      canvas.classList.remove('visible');
      const done = burst._onDone;
      burst._onDone = null;
      if (done) done();
    }
  }

  /** Called by the app once the user has interacted (unlocks Web Audio). */
  function unlockAudio() {
    const ac = ensureAudioContext();
    if (ac && ac.state === 'suspended') ac.resume().catch(function () {});
  }

  return { burst: burst, unlockAudio: unlockAudio };
})();

