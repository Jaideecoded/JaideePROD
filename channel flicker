  <script>
/* ==========================================================================
   ChannelFlicker — archive.org player
   --------------------------------------------------------------------------
   Plays public-domain video straight from archive.org into a native
   <video> element (no YouTube required):

     1. advancedsearch API  → 100 random-ish identifiers for the channel
     2. metadata API        → find a playable mp4 derivative per item
     3. stream https://archive.org/download/{id}/{file} (supports ranges)

   Mirrors the TVPlayer API surface (load / mute / unMute / setVolume /
   isMuted / on) so app.js can treat both sources uniformly. Caches search
   results in localStorage for 6 h; falls back to curated identifiers when
   the network is down.
   ========================================================================== */

window.TVArchive = (function () {
  'use strict';

  const SEARCH_TTL_MS = 6 * 60 * 60 * 1000;
  const ROWS = 100;

  const video = document.getElementById('archiveVideo');
  let loadToken = 0;          // cancels stale async resolutions
  let muted = true;
  let volume = 70;
  const listeners = { ended: [], error: [] };

  /* ---- helpers ----------------------------------------------------------- */

  function storageKey(text) { return 'cf.search.' + hash(text); }

  function hash(text) {
    let h = 5381;
    for (let i = 0; i < text.length; i++) h = ((h << 5) + h + text.charCodeAt(i)) | 0;
    return Math.abs(h).toString(36);
  }

  function readCache(query) {
    try {
      const hit = JSON.parse(localStorage.getItem(storageKey(query)) || 'null');
      if (hit && Date.now() - hit.t < SEARCH_TTL_MS && hit.docs.length) return hit.docs;
    } catch (e) { /* ignore */ }
    return null;
  }

  function writeCache(query, docs) {
    try { localStorage.setItem(storageKey(query), JSON.stringify({ t: Date.now(), docs: docs })); }
    catch (e) { /* quota — ignore */ }
  }

  function searchUrl(query) {
    const page = 1 + Math.floor(Math.random() * 60); // deep enough to stay fresh
    return 'https://archive.org/advancedsearch.php'
      + '?q=' + encodeURIComponent(query)
      + '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=year'
      + '&rows=' + ROWS + '&page=' + page + '&output=json';
  }

  function fetchJSON(url) {
    return fetch(url, { cache: 'no-cache' }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    });
  }

  /** Pick the best mp4 derivative from an item's file list. */
  function pickPlayableFile(files) {
    if (!files) return null;
    const mp4s = files.filter(function (f) {
      return /\.mp4$/i.test(f.name || '') && !/^(thumb|__ia_thumb)/i.test(f.name || '');
    });
    if (!mp4s.length) return null;
    const score = function (f) {
      const fmt = (f.format || '').toLowerCase();
      if (fmt.indexOf('512kb') !== -1) return 0;   // small + streams fast
      if (fmt.indexOf('h.264') !== -1) return 1;
      if (fmt.indexOf('mpeg4') !== -1) return 2;
      return 3;
    };
    mp4s.sort(function (a, b) { return score(a) - score(b); });
    return mp4s[0];
  }

  /* ---- public API --------------------------------------------------------- */

  /**
   * Resolve and start playing something from a channel definition.
   * cb({ id, title, year, source: 'archive' }) fires when playback starts.
   */
  function loadNext(channel, cb, onError) {
    const token = ++loadToken;

    function emit(item) {
      if (token !== loadToken) return;   // a newer load superseded this one
      cb(item);
    }
    function fail(err) {
      if (token !== loadToken) return;
      if (onError) onError(err);
    }

    function playItem(resolved) {
      video.src = resolved.url;
      video.muted = muted;
      video.volume = volume / 100;
      video.play().catch(function () { /* autoplay refusal — user will tap */ });
      emit({
        id: resolved.id,
        title: resolved.title,
        year: resolved.year || null,
        url: resolved.url,
        channel: channel.key,
        source: 'archive'
      });
    }

    function tryIdentifiers(pool, attemptsLeft, tried) {
      if (attemptsLeft <= 0 || !pool.length) {
        fail(new Error('no playable archive item'));
        return;
      }
      const identifier = pool.splice(Math.floor(Math.random() * pool.length), 1)[0];
      if (tried.indexOf(identifier) !== -1) return tryIdentifiers(pool, attemptsLeft - 1, tried);

      fetchJSON('https://archive.org/metadata/' + encodeURIComponent(identifier))
        .then(function (data) {
          const file = pickPlayableFile(data.files);
          if (!file) return tryIdentifiers(pool, attemptsLeft - 1, tried.concat(identifier));
          const md = data.metadata || {};
          const title = md.title || identifier;
          const year = md.year || (md.date ? String(md.date).slice(0, 4) : null);
          playItem({
            id: identifier,
            title: Array.isArray(title) ? title[0] : title,
            year: year,
            url: 'https://archive.org/download/' + encodeURIComponent(identifier)
               + '/' + encodeURIComponent(file.name)
          });
        })
        .catch(function () { tryIdentifiers(pool, attemptsLeft - 1, tried.concat(identifier)); });
    }

    // 1) try a live search, 2) cached search, 3) curated fallback list.
    const cached = readCache(channel.query);
    const attempt = function (docs) {
      const pool = docs.map(function (d) { return d.identifier; });
      tryIdentifiers(pool.slice(), 8, []);
    };

    fetchJSON(searchUrl(channel.query))
      .then(function (json) {
        const docs = (json.response && json.response.docs) || [];
        if (!docs.length) throw new Error('empty search');
        writeCache(channel.query, docs);
        attempt(docs);
      })
      .catch(function () {
        if (cached) { attempt(cached); return; }
        // Offline: stream straight from the curated fallback items.
        const pool = channel.fallback.slice().map(function (f) { return f.id; });
        if (!pool.length) { fail(new Error('no fallback items')); return; }
        tryIdentifiers(pool, 8, []);
      });
  }

  function setVolume(percent) {
    volume = Math.max(0, Math.min(100, percent));
    video.volume = volume / 100;
  }
  function mute()   { muted = true;  video.muted = true; }
  function unMute() { muted = false; video.muted = false; }
  function isMuted() { return muted; }
  function stop() {
    loadToken++;               // invalidate in-flight resolutions
    video.removeAttribute('src');
    video.load();              // detach stream, save bandwidth
  }

  video.addEventListener('ended', function () {
    listeners.ended.forEach(function (fn) { fn(); });
  });
  video.addEventListener('error', function () {
    if (video.src) listeners.error.forEach(function (fn) { fn(); });
  });

  /** Replay a previously resolved item (prev-channel history). */
  function playResolved(item) {
    if (!item || !item.url) return;
    video.src = item.url;
    video.muted = muted;
    video.volume = volume / 100;
    video.play().catch(function () { /* autoplay refusal — user will tap */ });
  }

  return {
    loadNext: loadNext,
    playResolved: playResolved,
    setVolume: setVolume,
    mute: mute,
    unMute: unMute,
    isMuted: isMuted,
    stop: stop,
    on: function (event, fn) { if (listeners[event]) listeners[event].push(fn); }
  };
})();

  </script>
  <script>
/* ==========================================================================
   ChannelFlicker — main app (multi-source)
   --------------------------------------------------------------------------
   The TV now has a full lineup:

     · MUSIC themes ("90s hip hop rnb", "rnb", "slow jams"…) → curated
       YouTube pool (js/data/videos.js)
     · Everything else maps to an archive.org channel (js/data/archive.js):
       midnight movies, cartoons, golden-age cinema, retro ads, newsreels,
       trailers, NASA, silent era — streamed as public-domain MP4s.

   If YouTube is unreachable at boot (or fails repeatedly), the TV
   automatically reroutes to archive.org and keeps flicking. A preset row
   in the control panel makes the channels discoverable.

   Keyboard: ↑/→ next · ↓/← previous · SPACE next · ENTER set theme · M mute
   ========================================================================== */

(function () {
  'use strict';

  const $ = function (id) { return document.getElementById(id); };

  const els = {
    screen: $('screen'),
    playerMount: $('player'),
    archiveVideo: $('archiveVideo'),
    osd: $('osd'),
    osdChannel: $('osdChannel'),
    osdInput: $('osdInput'),
    osdNow: $('osdNow'),
    unmuteBtn: $('unmuteBtn'),
    themeInput: $('themeInput'),
    nextBtn: $('nextBtn'),
    prevBtn: $('prevBtn'),
    favBtn: $('favBtn'),
    favOnly: $('favOnly'),
    presets: Array.prototype.slice.call(document.querySelectorAll('.preset')),
    volume: $('volume'),
    muteBtn: $('muteBtn')
  };

  const STORAGE_KEYS = {
    theme: 'cf.theme',
    favourites: 'cf.favourites',
    volume: 'cf.volume',
    favOnly: 'cf.favOnly'
  };

  const YT_ERROR_LIMIT = 3; // consecutive YT player errors before rerouting

  const state = {
    channel: 1 + Math.floor(Math.random() * 98),
    bag: [],
    lastVideo: null,
    history: [],
    theme: '90s hip hop rnb',
    favourites: [],
    favOnly: false,
    muted: true,
    switching: false,
    source: { type: 'youtube', channel: null },
    ytAvailable: null,     // null = unknown (API still booting)
    ytErrorCount: 0
  };

  /* ---- storage helpers -------------------------------------------------- */

  function loadStorage() {
    try {
      state.theme = localStorage.getItem(STORAGE_KEYS.theme) || state.theme;
      state.favourites = JSON.parse(localStorage.getItem(STORAGE_KEYS.favourites) || '[]');
      const vol = localStorage.getItem(STORAGE_KEYS.volume);
      if (vol !== null) els.volume.value = vol;
      state.favOnly = localStorage.getItem(STORAGE_KEYS.favOnly) === '1';
    } catch (e) { /* private mode etc. — defaults are fine */ }
  }

  function saveStorage() {
    try {
      localStorage.setItem(STORAGE_KEYS.theme, state.theme);
      localStorage.setItem(STORAGE_KEYS.favourites, JSON.stringify(state.favourites));
      localStorage.setItem(STORAGE_KEYS.volume, els.volume.value);
      localStorage.setItem(STORAGE_KEYS.favOnly, state.favOnly ? '1' : '0');
    } catch (e) { /* ignore */ }
  }

  /* ---- source resolution -------------------------------------------------- */

  /** Decide YouTube vs archive.org for the current theme string. */
  function resolveSource(theme) {
    const archiveChannel = window.CF_matchArchiveChannel(theme);
    if (archiveChannel) return { type: 'archive', channel: archiveChannel };
    return { type: 'youtube', channel: null };
  }

  /** Human-readable label for either source. */
  function label(video) {
    if (!video) return '';
    if (video.source === 'archive') {
      return video.title + (video.year ? ' (' + video.year + ')' : '');
    }
    return window.CF_label(video);
  }

  /* ---- YouTube pool -------------------------------------------------------- */

  function currentPool() {
    let pool = window.CF_filterByTheme(state.theme, window.CF_VIDEOS);
    if (state.favOnly) {
      const faves = pool.filter(function (v) { return state.favourites.indexOf(v.id) !== -1; });
      if (faves.length) pool = faves;
    }
    return pool;
  }

  function refillBag() {
    state.bag = window.CF_shuffle(currentPool());
  }

  function pickNextYouTube() {
    if (!state.bag.length) refillBag();
    let video = state.bag.pop();
    if (state.lastVideo && video.id === state.lastVideo.id && state.bag.length) {
      const alt = state.bag.pop();
      state.bag.push(video);
      video = alt;
    }
    return video;
  }

  /* ---- OSD ---------------------------------------------------------------- */

  function showOSD() {
    els.osd.classList.add('visible');
    clearTimeout(showOSD._timer);
    showOSD._timer = setTimeout(function () {
      els.osd.classList.remove('visible');
    }, 3500);
  }

  function setChannelDisplay() {
    els.osdChannel.textContent = 'CH ' + String(state.channel).padStart(2, '0');
  }

  function setInputDisplay() {
    const name = state.source.channel ? state.source.channel.label : '';
    els.osdInput.textContent = 'INPUT ' + (state.source.type === 'archive' ? 'SAT' : 'AUX')
      + (name ? ' · ' + name : '');
  }

  /* ---- playback hand-off ---------------------------------------------------- */

  function switchSourceTo(video) {
    if (video.source === 'archive') {
      TVPlayer.pause();
      els.playerMount.classList.remove('active');
      els.archiveVideo.classList.add('active');
    } else {
      TVArchive.stop();
      els.archiveVideo.classList.remove('active');
      els.playerMount.classList.add('active');
    }
  }

  let pendingYT = null; // video queued while the YT API was still booting

  function playVideo(video) {
    switchSourceTo(video);
    state.lastVideo = video;
    els.osdNow.textContent = label(video);
    updateFavButton(video);
    showOSD();
    if (video.source === 'archive') {
      if (video.url) {
        TVArchive.playResolved(video);   // history replay
      }
      // else: item was resolved by TVArchive.loadNext and is already playing.
      return;
    }
    if (TVPlayer.isReady()) {
      TVPlayer.load(video.id);
    } else {
      pendingYT = video;                 // replay once the API wakes up
    }
  }

  /* ---- channel changing ------------------------------------------------------ */

  function bumpChannel(direction) {
    state.channel += direction > 0 ? (1 + Math.floor(Math.random() * 3))
                                   : -(1 + Math.floor(Math.random() * 3));
    if (state.channel > 99) state.channel = 1;
    if (state.channel < 1) state.channel = 99;
    setChannelDisplay();
  }

  function changeChannel(direction) {
    if (state.switching) return;
    state.switching = true;

    let video = null;
    let usedFallback = false;

    if (direction < 0 && state.history.length) {
      video = state.history.pop();
      state.channel -= (1 + Math.floor(Math.random() * 3));
      if (state.channel < 1) state.channel = 99;
      setChannelDisplay();
    } else {
      // Reroute to a random archive channel if YouTube is known-dead.
      if (state.source.type === 'youtube' && state.ytAvailable === false) {
        const chans = window.CF_ARCHIVE_CHANNELS;
        state.source = { type: 'archive', channel: chans[Math.floor(Math.random() * chans.length)] };
        usedFallback = true;
      }
      if (state.source.type === 'youtube') {
        video = pickNextYouTube();
        video.source = 'youtube';
        if (state.lastVideo) state.history.push(state.lastVideo);
      } else {
        bumpChannel(1);
      }
    }

    setInputDisplay();
    showOSD();

    const LOAD_DELAY_MS = 220;
    if (video) {
      // History replay — the exact item we flicked away from, either source.
      if (video.source === 'archive' && video.channel) {
        state.source = {
          type: 'archive',
          channel: window.CF_ARCHIVE_CHANNELS.find(function (c) { return c.key === video.channel; }) || state.source.channel
        };
        setInputDisplay();
      }
      setTimeout(function () { playVideo(video); }, LOAD_DELAY_MS);
    } else if (state.source.type === 'youtube') {
      setTimeout(function () { playVideo(video); }, LOAD_DELAY_MS);
    } else {
      // Archive items resolve async — hand them the screen when ready.
      if (direction > 0 && state.lastVideo) state.history.push(state.lastVideo);
      const archiveChannel = state.source.channel;
      setTimeout(function () {
        TVArchive.loadNext(archiveChannel, function (item) {
          item.source = 'archive';
          playVideo(item);
        }, function () {
          els.osdNow.textContent = 'NO SIGNAL — ALLOW ARCHIVE.ORG IN BROWSER SETTINGS';
        });
        if (usedFallback) {
          els.osdNow.textContent = 'NO YOUTUBE — ARCHIVE FEED';
        }
      }, LOAD_DELAY_MS);
    }

    window.TVStatic.burst(650, {
      sound: !state.muted,
      onDone: function () { state.switching = false; }
    });
  }

  /** Consecutive YouTube player errors — after N, declare it dead. */
  function onYouTubeError() {
    state.ytErrorCount += 1;
    if (state.ytErrorCount >= YT_ERROR_LIMIT && state.ytAvailable !== false) {
      state.ytAvailable = false;
      if (state.source.type === 'youtube') changeChannel(1); // reroutes to archive
      return;
    }
    skipSamePool();
  }

  /** Quick hop to the next video within the current pool (no full static). */
  function skipSamePool() {
    if (state.switching) return;
    state.switching = true;
    if (state.source.type === 'youtube') {
      const video = pickNextYouTube();
      video.source = 'youtube';
      if (TVPlayer.isReady()) TVPlayer.load(video.id);
      state.lastVideo = video;
      els.osdNow.textContent = label(video);
      updateFavButton(video);
    } else {
      const channel = state.source.channel;
      TVArchive.loadNext(channel, function (item) {
        item.source = 'archive';
        playVideo(item);
      }, function () {
        els.osdNow.textContent = 'NO SIGNAL — ALLOW ARCHIVE.ORG IN BROWSER SETTINGS';
      });
    }
    window.TVStatic.burst(450, {
      sound: !state.muted,
      onDone: function () { state.switching = false; }
    });
  }

  /* ---- favourites -------------------------------------------------------------- */

  function updateFavButton(video) {
    const isFav = video && state.favourites.indexOf(video.id) !== -1;
    els.favBtn.textContent = isFav ? '★' : '☆';
    els.favBtn.classList.toggle('is-fav', !!isFav);
  }

  function toggleFavourite() {
    if (!state.lastVideo) return;
    const id = state.lastVideo.id;
    const idx = state.favourites.indexOf(id);
    if (idx === -1) {
      state.favourites.push(id);
    } else {
      state.favourites.splice(idx, 1);
      if (state.favOnly && state.source.type === 'youtube' &&
          !currentPool().some(function (v) { return state.favourites.indexOf(v.id) !== -1; })) {
        els.favOnly.checked = false;
        state.favOnly = false;
      }
    }
    saveStorage();
    updateFavButton(state.lastVideo);
    showOSD();
  }

  /* ---- audio --------------------------------------------------------------------- */

  function firstInteractionUnlocks() {
    window.TVStatic.unlockAudio();
    if (state.muted) {
      state.muted = false;
      TVPlayer.unMute();
      TVArchive.unMute();
      TVPlayer.setVolume(Number(els.volume.value));
      TVArchive.setVolume(Number(els.volume.value));
      els.unmuteBtn.hidden = true;
      els.muteBtn.textContent = '🔊';
    }
  }

  /* ---- theme / presets -------------------------------------------------------------- */

  function applyTheme(value) {
    value = (value || '').trim();
    if (!value || value === state.theme) return;
    state.theme = value;
    saveStorage();
    state.source = resolveSource(value);
    refillBag();
    changeChannel(1);
  }

  function bindThemeInput() {
    els.themeInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { applyTheme(els.themeInput.value); els.themeInput.blur(); }
      e.stopPropagation();
    });
    els.themeInput.addEventListener('input', function () {
      clearTimeout(bindThemeInput._debounce);
      bindThemeInput._debounce = setTimeout(function () {
        applyTheme(els.themeInput.value);
      }, 900);
    });
  }

  function bindPresets() {
    els.presets.forEach(function (btn) {
      btn.addEventListener('click', function () {
        els.themeInput.value = btn.getAttribute('data-theme');
        applyTheme(btn.getAttribute('data-theme'));
      });
    });
  }

  /* ---- wiring ------------------------------------------------------------------------- */

  function bindEvents() {
    els.nextBtn.addEventListener('click', function () { changeChannel(1); });
    els.prevBtn.addEventListener('click', function () { changeChannel(-1); });
    els.favBtn.addEventListener('click', toggleFavourite);
    els.unmuteBtn.addEventListener('click', firstInteractionUnlocks);

    els.muteBtn.addEventListener('click', function () {
      state.muted = !state.muted;
      if (state.muted) {
        TVPlayer.mute();
        TVArchive.mute();
        els.muteBtn.textContent = '🔇';
      } else {
        firstInteractionUnlocks();
      }
    });

    els.volume.addEventListener('input', function () {
      TVPlayer.setVolume(Number(els.volume.value));
      TVArchive.setVolume(Number(els.volume.value));
      saveStorage();
    });

    els.favOnly.addEventListener('change', function () {
      state.favOnly = els.favOnly.checked;
      saveStorage();
      refillBag();
      changeChannel(1);
    });

    document.addEventListener('keydown', function (e) {
      if (e.target === els.themeInput) return;
      switch (e.key) {
        case 'ArrowUp':
        case 'ArrowRight':
        case ' ':
          e.preventDefault();
          firstInteractionUnlocks();
          changeChannel(1);
          break;
        case 'ArrowDown':
        case 'ArrowLeft':
          e.preventDefault();
          firstInteractionUnlocks();
          changeChannel(-1);
          break;
        case 'Enter':
          firstInteractionUnlocks();
          els.themeInput.focus();
          els.themeInput.select();
          break;
        case 'm':
        case 'M':
          els.muteBtn.click();
          break;
        default:
          firstInteractionUnlocks();
      }
    });

    document.addEventListener('pointerdown', firstInteractionUnlocks);
  }

  /* ---- boot ---------------------------------------------------------------------------- */

  function boot() {
    loadStorage();
    els.themeInput.value = state.theme;
    els.favOnly.checked = state.favOnly;
    state.source = resolveSource(state.theme);
    setChannelDisplay();
    setInputDisplay();
    refillBag();

    // YouTube: boots muted; if it can't load at all we reroute to archive.
    TVPlayer.on('ready', function () {
      state.ytAvailable = true;
      state.ytErrorCount = 0;
      TVPlayer.setVolume(Number(els.volume.value));
      if (pendingYT) {
        const queued = pendingYT;
        pendingYT = null;
        TVPlayer.load(queued.id);        // video queued before API was ready
      } else if (state.source.type === 'youtube' && !state.lastVideo) {
        const video = pickNextYouTube();
        video.source = 'youtube';
        playVideo(video);
      }
    });

    TVPlayer.create('player').catch(function () {
      state.ytAvailable = false;
      if (state.source.type === 'youtube') {
        els.osdNow.textContent = 'NO YOUTUBE — ARCHIVE FEED';
        const chans = window.CF_ARCHIVE_CHANNELS;
        state.source = { type: 'archive', channel: chans[Math.floor(Math.random() * chans.length)] };
        setInputDisplay();
        showOSD();
        TVArchive.loadNext(state.source.channel, function (item) {
          item.source = 'archive';
          playVideo(item);
        }, function () {
          els.osdNow.textContent = 'NO SIGNAL — ALLOW ARCHIVE.ORG IN BROWSER SETTINGS';
        });
      }
    });

    TVPlayer.on('error', onYouTubeError);
    TVPlayer.on('ended', function () {
      setTimeout(function () { changeChannel(1); }, 2000);
    });

    TVArchive.on('ended', function () {
      setTimeout(function () { changeChannel(1); }, 2000);
    });
    TVArchive.on('error', skipSamePool);

    bindEvents();
    bindThemeInput();
    bindPresets();
  }

  boot();
})();

  </script>
