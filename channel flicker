/* ==========================================================================
   ChannelFlicker — CRT television styling
   The CRT aesthetic is the star: scanlines, curvature illusion, vignette,
   flicker, glow. Everything else stays quiet.
   ========================================================================== */

:root {
  --room-bg-1: #0b0d12;
  --room-bg-2: #05060a;
  --bezel-1: #3a3f46;
  --bezel-2: #22262c;
  --bezel-3: #14171b;
  --osd-green: #65f26b;
  --led-red: #ff3b30;
  --text-dim: #8b93a1;
  --screen-radius: 18px / 42px;   /* slight barrel-corner rounding */
}

* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  color: var(--text-dim);
  background:
    radial-gradient(1200px 800px at 50% 30%, #14181f 0%, var(--room-bg-1) 45%, var(--room-bg-2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
}

.room {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  padding: 24px;
  width: 100%;
}

/* --------------------------------------------------------------------------
   The set
   -------------------------------------------------------------------------- */

.tv {
  width: min(920px, 94vw);
  background: linear-gradient(160deg, var(--bezel-1) 0%, var(--bezel-2) 55%, var(--bezel-3) 100%);
  border-radius: 26px;
  padding: 18px 22px 20px;
  box-shadow:
    0 2px 0 rgba(255, 255, 255, 0.06) inset,
    0 -14px 30px rgba(0, 0, 0, 0.45) inset,
    0 30px 80px rgba(0, 0, 0, 0.65),
    0 8px 24px rgba(0, 0, 0, 0.5);
}

.tv-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 2px 6px 12px;
}

.brand {
  font-size: 12px;
  letter-spacing: 3px;
  color: #cfd6e0;
  text-shadow: 0 0 6px rgba(120, 220, 255, 0.25);
}

.brand-model { color: #5d6675; letter-spacing: 2px; }

.speaker-grill {
  flex: 1;
  height: 10px;
  border-radius: 5px;
  background: repeating-linear-gradient(90deg,
    #1a1e23 0 3px, transparent 3px 7px);
  max-width: 320px;
}

.led {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #3a1512;
  box-shadow: 0 0 0 2px #101216;
}
.led.on {
  background: var(--led-red);
  box-shadow: 0 0 8px 2px rgba(255, 59, 48, 0.7), 0 0 0 2px #101216;
}

/* --------------------------------------------------------------------------
   Screen + CRT dressing
   -------------------------------------------------------------------------- */

.bezel {
  background: linear-gradient(180deg, #101318, #080a0d);
  border-radius: 22px;
  padding: 12px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.8) inset;
}

.screen {
  position: relative;
  aspect-ratio: 4 / 3;
  width: 100%;
  overflow: hidden;
  background: #000;
  border-radius: var(--screen-radius);
  /* curvature illusion: strong inner shadow hugging the edges */
  box-shadow:
    0 0 0 2px #000,
    0 0 40px 6px rgba(0, 0, 0, 0.9) inset,
    0 0 90px 18px rgba(0, 0, 0, 0.7) inset;
}

.player-mount,
.player-mount iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  /* overscan: crop a little so the YT chrome hides behind the curve */
  transform: scale(1.06);
  pointer-events: none; /* the TV remote is the only remote that matters */
  background: #000;
}

/* archive.org streams (native <video>) sit in the same spot as the YT iframe */
.archive-mount {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;          /* 4:3 films letterbox like a real set */
  background: #000;
  transform: scale(1.06);
  pointer-events: none;
  display: none;
}
.archive-mount.active { display: block; }

/* default: the YouTube mount is "tuned in" */
.player-mount.active { display: block; }
.player-mount { display: none; }

.overlay { position: absolute; inset: 0; pointer-events: none; }

/* scanlines + subtle aperture-grille colour */
.scanlines {
  background:
    repeating-linear-gradient(0deg,
      rgba(0, 0, 0, 0.22) 0 1px,
      rgba(255, 255, 255, 0.015) 1px 3px),
    repeating-linear-gradient(90deg,
      rgba(255, 0, 0, 0.02) 0 1px,
      rgba(0, 255, 0, 0.02) 1px 2px,
      rgba(0, 0, 255, 0.02) 2px 3px);
  mix-blend-mode: normal;
}

/* glass curvature: bright top-left arc + dark bottom edge */
.curvature {
  background:
    radial-gradient(140% 100% at 50% 0%, rgba(255, 255, 255, 0.07) 0%, transparent 45%),
    radial-gradient(120% 90% at 50% 115%, rgba(0, 0, 0, 0.55) 0%, transparent 55%);
}

/* vignette + faint moving flicker */
.vignette {
  background: radial-gradient(115% 115% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  animation: flicker 4.2s infinite steps(60);
}

@keyframes flicker {
  0%, 100% { opacity: 0.92; }
  8%  { opacity: 0.86; }
  9%  { opacity: 0.97; }
  32% { opacity: 0.9; }
  33% { opacity: 1; }
  61% { opacity: 0.88; }
  62% { opacity: 0.95; }
}

/* static noise canvas — stretched from low res for chunky analog pixels */
.static {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  image-rendering: pixelated;
  opacity: 0;
  transition: opacity 60ms linear;
  z-index: 3;
}
.static.visible { opacity: 1; }

/* --------------------------------------------------------------------------
   On-screen display (OSD)
   -------------------------------------------------------------------------- */

.osd {
  position: absolute;
  top: 8%;
  left: 6%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: var(--osd-green);
  text-shadow: 0 0 8px rgba(101, 242, 107, 0.8), 1px 0 0 rgba(101, 242, 107, 0.35);
  opacity: 0;
  transition: opacity 200ms ease;
  pointer-events: none;
  font-weight: 700;
}
.osd.visible { opacity: 1; }

.osd-channel { font-size: clamp(20px, 4vw, 34px); letter-spacing: 2px; }
.osd-input   { font-size: clamp(10px, 1.6vw, 14px); letter-spacing: 3px; opacity: 0.85; }
.osd-now     {
  font-size: clamp(10px, 1.6vw, 14px);
  letter-spacing: 1px;
  max-width: 60ch;
  opacity: 0.9;
  text-shadow: 0 0 6px rgba(101, 242, 107, 0.6);
}

/* sound invite shown until first user gesture unlocks audio */
.unmute-hint {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  padding: 10px 18px;
  font: inherit;
  font-size: 13px;
  letter-spacing: 2px;
  color: #eaf7ea;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(101, 242, 107, 0.7);
  border-radius: 4px;
  cursor: pointer;
  animation: blink 1.4s infinite steps(2);
}
@keyframes blink { 50% { opacity: 0.35; } }

/* --------------------------------------------------------------------------
   Front control panel
   -------------------------------------------------------------------------- */

.tv-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 16px 6px 2px;
}

.theme-input {
  flex: 1 1 220px;
  min-width: 160px;
  padding: 10px 14px;
  font: inherit;
  font-size: 13px;
  letter-spacing: 1px;
  color: #d7dee8;
  background: #0d1014;
  border: 1px solid #2c323a;
  border-radius: 8px;
  outline: none;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6) inset;
}
.theme-input:focus { border-color: #4d94ff; box-shadow: 0 0 8px rgba(77, 148, 255, 0.35); }

.knob-btn {
  padding: 10px 14px;
  font: inherit;
  font-size: 13px;
  letter-spacing: 1px;
  color: #d7dee8;
  background: linear-gradient(180deg, #343a42, #22262c);
  border: 1px solid #10131a;
  border-radius: 8px;
  cursor: pointer;
  box-shadow: 0 2px 0 rgba(255, 255, 255, 0.05) inset, 0 3px 8px rgba(0, 0, 0, 0.5);
  transition: transform 80ms ease, filter 120ms ease;
}
.knob-btn:hover { filter: brightness(1.15); }
.knob-btn:active { transform: translateY(1px); }
.knob-btn--wide { min-width: 108px; color: #ffe9a8; }
.knob-btn.is-fav { color: #ffd34d; text-shadow: 0 0 8px rgba(255, 211, 77, 0.6); }

.fav-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  letter-spacing: 2px;
  color: #98a1af;
  cursor: pointer;
  user-select: none;
}

.volume {
  width: 120px;
  accent-color: #65f26b;
  cursor: pointer;
}

.hint {
  margin: 0;
  font-size: 11px;
  letter-spacing: 1px;
  color: #4d5563;
  text-align: center;
  white-space: pre-line;
}

/* channel lineup chips */
.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 10px 6px 0;
}

.preset {
  padding: 6px 12px;
  font: inherit;
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #9aa3b2;
  background: #14171c;
  border: 1px solid #2c323a;
  border-radius: 999px;
  cursor: pointer;
  transition: color 120ms ease, border-color 120ms ease;
}
.preset:hover { color: #65f26b; border-color: #3d5c40; }
.preset:active { transform: translateY(1px); }

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media (max-width: 720px) {
  body { overflow: auto; }
  .screen { aspect-ratio: 4 / 3; }
  .volume { width: 90px; }
  .hint { display: none; }
}

